# Production Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_123456
POSTGRES_DB=timesheet_db
DATABASE_URL=postgresql://postgres:CHANGE_THIS_TO_STRONG_PASSWORD_123456@db:5432/timesheet_db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# CORS Configuration - IMPORTANT!
# Replace with your actual domain
CORS_ORIGINS=["https://api.your-domain.com","https://*.amocrm.ru","https://*.amocrm.com"]

# Security
# Generate with: openssl rand -hex 32
SECRET_KEY=GENERATE_RANDOM_64_CHARACTER_KEY_HERE

# Optional: Application Settings
APP_NAME=Timesheet IL
APP_VERSION=1.0.0

